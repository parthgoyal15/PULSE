# Get a free key: https://aistudio.google.com/apikey
# Without a key the app still runs, but the dashboard labels every score MOCK.
GEMINI_API_KEY=your_gemini_api_key

# true (default): if Gemini is missing/fails, agents return labelled mock JSON
# false: API returns 503 so a judging demo cannot silently fake Google AI
ALLOW_MOCK_AGENTS=true

# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
# Without these, alerts are printed to the backend console (demo delivery).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=pulse_verify_token_2024

# Optional CMO numbers for live WhatsApp (E.164 without +)
CMO_PHONE_MH=
CMO_PHONE_OD=
CMO_PHONE_RJ=
CMO_PHONE=
